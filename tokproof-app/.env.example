# ─────────────────────────────────────────────────────────
#  Tokproof — Variables de entorno
#
#  Cómo usar:
#  1. Copia este archivo: cp .env.example .env.local
#  2. Rellena cada valor con los datos de tu proyecto Supabase
#  3. NUNCA subas .env.local a git (ya está en .gitignore)
# ─────────────────────────────────────────────────────────

# ── Supabase (obligatorio) ──────────────────────────────
# Encuéntralo en: supabase.com → tu proyecto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Dominios públicos ──────────────────────────────────
# Dominio donde viven las landing pages de usuarios
NEXT_PUBLIC_PUBLIC_APP_URL=https://tokproof.app
